# Server Configuration
PORT=3000
NODE_ENV=development

# Optional GenAI Provider API Keys (Supports Google Gemini or Groq)
# The application functions with 100% full feature parity offline even without an API key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Alternative:
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b

# Security & Rate Limiting (Default: 60 requests per 60,000ms window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
